{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/enso/oni",
      "destination": "https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt"
    },
    {
      "source": "/api/enso/nino12",
      "destination": "https://www.cpc.ncep.noaa.gov/data/indices/sstoi.indices"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
